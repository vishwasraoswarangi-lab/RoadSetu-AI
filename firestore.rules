rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return userExists() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isAuthority() {
      return userExists() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['authority', 'municipal_officer', 'admin'];
    }

    // User profiles: users can read/update their own profile, authorities can read profiles for operational work.
    // Role and clearance changes are never allowed from the client unless the existing caller is an admin.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAuthority();
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'citizen';
      allow update: if isOwner(userId)
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'clearanceLevel'])
          || isAdmin()
        );
      allow delete: if isAdmin();
    }

    // Public map transparency should expose only intentionally public report fields from the client.
    // Report creation requires an authenticated Firebase user.
    match /reports/{reportId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthority() || (
        isOwner(resource.data.userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'status', 'escrowStatus', 'disbursedAmount', 'contractorId', 'contractorName', 'payoutAmount', 'assignedDepartment'
        ])
      );
      allow delete: if isAdmin() || (isOwner(resource.data.userId) && resource.data.status == 'submitted');
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Repair evidence is operational data. Only authenticated users can access it; authorities/admins can manage it.
    match /repair_updates/{updateId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.submittedBy == request.auth.uid;
      allow update: if isAdmin() || isAuthority();
      allow delete: if isAdmin();
    }
  }
}
